{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --config playwright.visual.config.ts",
    "e2e:a11y": "playwright test --config playwright.a11y.config.ts",
    "mocks:worker": "msw init public --save",
    "deploy": "node ../../scripts/deploy-guard.ts && wrangler deploy",
    "deploy:preview": "wrangler versions upload"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@workspace/contracts": "workspace:*",
    "@workspace/mocks": "workspace:*",
    "@workspace/ui": "workspace:*",
    "i18next": "27.2.10",
    "i18next-browser-languagedetector": "8.3.1",
    "msw": "3.0.8",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@cloudflare/vite-plugin": "1.70.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "i18next-cli": "1.95.4",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "wrangler": "4.168.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
