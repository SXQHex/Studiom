{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static SPA on Cloudflare Workers static assets (ADR-005, ADR-011).
  // The Cloudflare Vite plugin sets the asset directory in the build output.
  "name": "studiom",
  // The deploy guard (ADR-016) is added in vite.config.ts.
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "studiom.fethiyetango.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
}
