{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".turbo/",
    "coverage/",
    "pnpm-lock.yaml",
    ".pnpm-store/",
    "docs/reference/prototype-v2/**",
    ".agents/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/public/mockServiceWorker.js",
    "apps/web/src/types/**"
  ]
}
