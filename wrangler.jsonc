{
  // Static SPA on Cloudflare Workers static assets (ADR-005, ADR-011).
  // Assets come from the Vite build output; run `pnpm build` before deploying.
  "name": "studiom",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "studiom.fethiyetango.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
}
